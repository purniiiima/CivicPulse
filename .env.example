# CivicPulse Environment Configuration

# Server & Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/civicpulse_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/civicpulse_db"
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
API_PREFIX="/api/v1"
ENVIRONMENT="development"
PORT="3000"

# Map Provider Configuration (100% Free Open-Source Location Intelligence via Leaflet & OpenStreetMap)
# Supported providers: 'leaflet', 'openstreetmap', 'carto'
VITE_MAP_PROVIDER="leaflet"
VITE_DEFAULT_MAP_LAT="28.6139"
VITE_DEFAULT_MAP_LNG="77.2090"
VITE_DEFAULT_MAP_ZOOM="12"

