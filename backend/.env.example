# Backend Environment Configuration
PROJECT_NAME="CivicPulse API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL asyncpg / fallback SQLite)
DATABASE_URL="sqlite+aiosqlite:///./civicpulse.db"
DATABASE_URL_SYNC="sqlite:///./civicpulse.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/civicpulse_db"
# DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/civicpulse_db"

# Security & JWT Authentication
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# CORS Allowed Origins
# Defaults: http://localhost:5173, http://127.0.0.1:5173, http://localhost:3000
